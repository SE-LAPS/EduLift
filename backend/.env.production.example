# EduLift Backend Production Environment Configuration
# Copy this file to .env and update with your actual values

# ============================================
# FLASK CONFIGURATION
# ============================================
FLASK_ENV=production
DEBUG=False

# ============================================
# SECURITY KEYS (REQUIRED - GENERATE UNIQUE VALUES)
# ============================================
# Generate using: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CHANGE_THIS_TO_RANDOM_SECRET_KEY_MIN_32_CHARS
JWT_SECRET_KEY=CHANGE_THIS_TO_RANDOM_JWT_KEY_MIN_32_CHARS

# ============================================
# DATABASE CONFIGURATION (cPanel MySQL)
# ============================================
# Format: mysql+pymysql://username:password@host:port/database_name
# cPanel typically prefixes database names with your username (e.g., cpanel_user_edulift_prod)
DATABASE_URL=mysql+pymysql://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:3306/YOUR_DB_NAME

# ============================================
# FRONTEND CONFIGURATION
# ============================================
# Your frontend domain (used for CORS)
FRONTEND_URL=https://yourdomain.com

# ============================================
# API CONFIGURATION
# ============================================
PORT=5000

# ============================================
# ADMIN CONFIGURATION
# ============================================
# Initial admin password for first-time setup
ADMIN_PASSWORD=CHANGE_THIS_SECURE_ADMIN_PASSWORD

# ============================================
# FILE UPLOAD CONFIGURATION
# ============================================
MAX_CONTENT_LENGTH=16777216
UPLOAD_FOLDER=/home/your_cpanel_username/backend/uploads

# ============================================
# JWT CONFIGURATION
# ============================================
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=2592000
JWT_COOKIE_SECURE=True

# ============================================
# REDIS CONFIGURATION (Optional - if available)
# ============================================
# REDIS_URL=redis://localhost:6379/0

# ============================================
# DATABASE INITIALIZATION
# ============================================
# Set to true ONLY on first deployment to initialize database
# Set to false after database is initialized
INIT_DB=false
