# EduLift Frontend Production Environment Configuration
# Copy this file to .env.production and update with your actual values

# ============================================
# API CONFIGURATION
# ============================================
# Your backend API URL (use subdomain or port)
# Option 1: Subdomain (Recommended)
NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api

# Option 2: Port-based (if no subdomain)
# NEXT_PUBLIC_API_URL=https://yourdomain.com:5000/api

# ============================================
# SITE CONFIGURATION
# ============================================
# Your frontend domain
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# ============================================
# FEATURE FLAGS
# ============================================
# Set to false for production (uses real API)
NEXT_PUBLIC_USE_MOCK=false

# ============================================
# ENVIRONMENT
# ============================================
NODE_ENV=production
